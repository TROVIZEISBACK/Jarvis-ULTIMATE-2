# Copy to .env and adjust.

# Brain:
#   claude-code  run Opus 5.5 through Claude Code, billed to your Claude Pro/Max plan (no API credits)
#   api          call the Anthropic API directly, billed to API credits (set ANTHROPIC_API_KEY)
#   auto         claude-code if a recent Claude Code is installed, else api   (default)
JARVIS_BRAIN=auto
# Optional: path to a specific Claude Code binary (default: newest one found)
# JARVIS_CLAUDE_BIN=
# Only used when JARVIS_BRAIN=api. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# What JARVIS calls you
JARVIS_OWNER=sir

# Brain: low | medium | high | xhigh | max  (higher = smarter on hard tasks, slower, pricier)
JARVIS_EFFORT=medium
# API brain only: 1 = Opus fast mode (up to 2.5x faster replies, 2x price)
JARVIS_FAST=0

# Ask out loud before destructive commands (rm -rf, sudo, shutdown, Remove-Item -Recurse, empty trash...)
JARVIS_CONFIRM_DANGEROUS=1

# Fallback voice when Kokoro isn't available. macOS: any voice from `say -v '?'` (Daniel = British).
# Windows uses an installed British male SAPI voice if there is one; Linux uses espeak-ng (en-gb).
JARVIS_VOICE=Daniel
JARVIS_VOICE_RATE=190
JARVIS_STT_LANGUAGE=en-US
# Voice: "kokoro" (neural British voice, runs locally on any OS) or "say" (the system voice)
JARVIS_TTS=kokoro
JARVIS_KOKORO_VOICE=bm_george
JARVIS_KOKORO_SPEED=1.0
JARVIS_KOKORO_THREADS=4
# Microphone: "push" = closed until you press ⌘H (Mac) / Ctrl+Alt+J (Windows, Linux) or the mic button (default)
#             "wake" = always listening for "Jarvis"
JARVIS_MIC_MODE=push
JARVIS_WAKE_WORDS=jarvis,javis,jarvas,jervis

# Conversation memory: JARVIS logs every exchange on this computer (data/history.jsonl) and carries a
# summary of it into every new conversation, so it remembers across restarts. The live conversation is
# compacted when it fills this percentage of the model's context window. JARVIS_HISTORY=0 switches it off.
JARVIS_HISTORY=1
JARVIS_COMPACT_AT=60

# Sentinel: JARVIS checks in by itself during part of the day and speaks only when something needs you.
# A status check (text) and a separate screen check (one screenshot, sent to Anthropic), each a small
# request to Claude Sonnet 5.5 only. Off by default; also switchable in the HUD or by voice.
JARVIS_SENTINEL=0
JARVIS_SENTINEL_HOURS=08:00-12:30
JARVIS_SENTINEL_TEXT_MINUTES=10
JARVIS_SENTINEL_SCREEN_MINUTES=25

# Image generation (Cloudflare Workers AI). Create a token with the "Workers AI" permission at
# https://dash.cloudflare.com/profile/api-tokens ; the account ID is on the dashboard (Workers & Pages).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
